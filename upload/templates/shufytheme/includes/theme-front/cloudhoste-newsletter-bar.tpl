<!-- CloudHoste Newsletter Subscription Section -->
<div class="py-5" style="background-color: var(--ch-navy, #0b0e1a);">
	<div class="container">
		<div class="p-4 p-md-5 rounded-4 text-center mx-auto max-w-90 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(73, 66, 228, 0.15) 0%, rgba(196, 238, 24, 0.1) 100%), var(--ch-surface-card-dark, #1A1C1E); border: 1px solid rgba(255, 255, 255, 0.12);">
			<div class="max-w-75 mx-auto">
				<h2 class="text-white font-weight-800 display-5 mb-2">Get notified when we launch new offers & discounts</h2>
				<p class="text-light opacity-80 fs-18 mb-4">Get new products, freebies, and news delivered straight to your inbox.</p>
				
				<form action="#" method="post" onsubmit="event.preventDefault(); alert('Thank you for subscribing to CloudHoste updates!');" class="mb-3">
					<div class="input-group input-group-lg max-w-80 mx-auto">
						<input type="email" class="form-control bg-dark text-white border-secondary rounded-pill px-4" placeholder="Your email..." required style="height: 54px;" />
						<button class="btn btn-primary px-4 rounded-pill font-weight-700 ml-2" type="submit" style="height: 54px;">
							Subscribe to Our Newsletter <i class="fas fa-paper-plane ms-2"></i>
						</button>
					</div>
					<div class="form-check d-flex align-items-center justify-content-center gap-2 mt-3">
						<input class="form-check-input mt-0" type="checkbox" id="termsCheck" required checked />
						<label class="form-check-label text-light fs-13 opacity-80" for="termsCheck">
							I have read and agree to the <a href="https://cloudhoste.eu/privacy-policy.html" target="_blank" class="ch-lime-text text-decoration-underline">Terms of Service</a>
						</label>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
